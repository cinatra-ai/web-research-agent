{
  "name": "@cinatra-ai/web-research-agent",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "description": "Stateless schema-driven web research enricher — takes a caller-supplied rows array and research prompt, uses web_search to enrich each row, and returns enrichedRows + extractionNotes + failures + webChecks. Hard bounds: rows.length in [1, 20], sources.length <= 10. Caller chunks larger inputs.",
