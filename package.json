    "apiVersion": "cinatra.ai/v1",
    "kind": "agent",
    "displayName": "Web Research Agent",
    "dependencies": [
      {
        "packageName": "@cinatra-ai/web-research-skill",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "*"
        },
        "requirement": "required",
        "kind": "skill"
      },
      {
        "packageName": "@cinatra-ai/json-artifact",
        "edgeType": "runtime",
        "versionConstraint": {
          "kind": "semver-range",
          "range": "^0.1.0"
        },
        "requirement": "required",
        "kind": "artifact"
      }
    ],
    "consumes": [],
    "packageType": "agent",
    "manifestVersion": 1,
    "sourceTemplateId": "web-research-agent-flow",
    "sourceVersionId": "80c68b88-8f81-4c80-ad5f-275877f44fae",
    "sourceVersionNumber": 1,
    "riskLevel": "low",
    "hasApprovalGates": false,
    "toolAccess": [],
    "ownerOrgId": null
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  }
}
